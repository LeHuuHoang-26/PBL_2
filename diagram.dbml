TableGroup "Account" [color: #65d254] {
  Manager
  Permission
}

Table Manager {
  MA_ID varchar(15) pk
  MA_FullName varchar(255)
  MA_Phone varchar(31)
  MA_Gender boolean
  MA_Age int
  MA_Username varchar(255)
  MA_Password varchar(255)
  MA_Role int
  MA_Status boolean
}

Table Permission {
  Per_ID varchar(15) pk
  MA_ID varchar(15) [ref: > Manager.MA_ID]
  Expires_At datetime
}

TableGroup "Medical" [color: #3f8cda] {
  Doctor
  Specialty
  Patient
  Symptom
  Symptom_Patient
  Appointment
}

Table Doctor {
  D_ID varchar(15) pk
  D_FullName varchar(255)
  D_Phone varchar(31)
  D_Gender boolean
  D_Age int
  Sp_ID varchar(15) [ref: > Specialty.Sp_ID]
  D_State boolean
  Room_ID varchar(15)
  Consultation_Fee decimal(10,2)
  Rating decimal(3,2)
}

Table Specialty {
  Sp_ID varchar(15) pk
  Specialty varchar(255)
}

Table Patient {
  P_ID varchar(15) pk
  P_FullName varchar(255)
  P_Phone varchar(31)
  P_Gender boolean
  P_Age int
  P_CCCD varchar(31)
}

Table Symptom {
  S_ID varchar(15) pk
  S_Name varchar(255)
  Sp_ID varchar(15) [ref: > Specialty.Sp_ID]
  S_Score int
}

Table Symptom_Patient {
  SP_ID varchar(15) pk
  S_ID varchar(15) [ref: > Symptom.S_ID]
  P_ID varchar(15) [ref: > Patient.P_ID]
  Sp_ID varchar(15) [ref: > Specialty.Sp_ID]
  Date datetime
}

Table Appointment {
  A_ID varchar(15) pk
  SP_ID varchar(15) [ref: > Symptom_Patient.SP_ID]
  D_ID varchar(15) [ref: > Doctor.D_ID]
  A_DateSet datetime
  A_DateGet datetime
  A_State boolean
}